# Copy this file to ".env" and paste your own keys in.
# Get them at dashboard.razorpay.com -> switch to Test Mode ->
# Account & Settings -> API Keys -> Generate Test Key.
#
# .env is listed in .gitignore, so your keys will not be committed.
# Only test keys work; the client refuses anything that is not rzp_test_.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
